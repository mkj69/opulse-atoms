  "modes": [
    {"name":"Fixpoint until stable","description":"Repeat a monotone step on a finite domain until its value stops changing.","example":"reach(Edges<A:B,B:C>, A)","result":"Designed result: Set<A,B,C>. One-hop expansion adds B, then C, then stops unchanged."},
    {"name":"Memoized recursion","description":"Cache repeated subcalls; record memo cost and the cost of plain unfolding separately.","example":"@chart[one,multiply,identity,combine_count,zero](Word<2,\"+\",2,\"*\",2,\"+\",2,\"*\",2,\"+\",2,\"*\",2,\"+\",2>)","result":"The core chart run above returns 429. This design sketch does not compare memo cost with plain unfolding cost."},
