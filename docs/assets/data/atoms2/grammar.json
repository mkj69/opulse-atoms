  "cards": [
    {"kind":"object","form":"ExprTree<\"add\",2,ExprTree<\"mul\",2,2>>","job":"Store a typed tree","name":"ExprTree<\"add\",2,ExprTree<\"mul\",2,2>>","layer":1,"definition":"obj ExprTree = Leaf<value: Int> | Branch<left: ExprTree, operator: Op, right: ExprTree> L1","depends_on":["Int","Op"],"effect":"Declares leaf and branch forms for a proposed typed tree; a Word alone loses its left and right branches. No validation run is attached."},
    {"kind":"operation","form":"split(Word<2,\"+\",2,\"*\",2>)","job":"Compute a split","name":"split(Word<2,\"+\",2,\"*\",2>)","layer":1,"definition":"op split(w: Word) -> List = depth_zero_binary_positions(w) L1","depends_on":["Word"],"effect":"Proposes finding top-level splits; it does not decide which tree to keep. The called operation is not implemented by this design."},
    {"kind":"combinator","form":"@chart[one,multiply,identity,combine_count,zero](w)","job":"Combine reusable calls","name":"@chart[one,multiply,identity,combine_count,zero](Word<2,\"+\",2,\"*\",2>)","layer":2,"definition":"comb @chart[leaf: A -> A, join: A -> A, wrap: A -> A, merge: A -> A, zero_slot: A -> A](w: A) -> A = @bounded_rec[leaf,join,wrap,merge,zero_slot](w) L2","depends_on":["split","one","multiply","identity","combine_count","zero"],"effect":"Design summary of the core chart: split public spans, reuse memoized subcalls and combine their counts. The executable declaration is in the core export."},
    {"kind":"observation","form":"?parse_count{w}","job":"Read a permitted result","name":"?parse_count{Word<2,\"+\",2,\"*\",2,\"+\",2,\"*\",2,\"+\",2,\"*\",2,\"+\",2>}","layer":3,"definition":"obs ?parse_count{w} = @chart[one,multiply,identity,combine_count,zero](w) L3","depends_on":["@chart","one","multiply","identity","combine_count","zero"],"effect":"The grammar world defines the observation using the promoted chart and counting operations. Its bounded evidence is linked from the core run."},
    {"kind":"law","form":"#assoc_count","job":"State a scoped law","name":"#assoc_count","layer":4,"definition":"law #assoc_count: eq(?parse_count{w}, catalan(binary_ops(w))) for w: Word L4","depends_on":["?parse_count","binary_ops"],"effect":"Proposed invariant for binary words; the intended unparenthesized scope still needs a certificate. No grammar-world certificate is attached; the core can check a law on a specified domain before rewriting."},
    {"kind":"bridge","form":"~to_rpn(t)","job":"Translate an interface","name":"~to_rpn(ExprTree<\"add\",2,ExprTree<\"mul\",2,2>>)","layer":2,"definition":"bridge ~to_rpn: ExprTree -> List = @fold[emit_token, append_postfix](x) L2","depends_on":["ExprTree","@fold"],"effect":"Proposes a postfix translation; it needs a declared fold and commuting interface. No grammar-world commuting check is attached; the core can verify bridges on a specified domain."}
  ],
  "template": {
    "definition":"template obj Quot[T: obj, canon: op] = refine T canon(canon) L1",
    "instances":[
      {"name":"Frac","definition":"obj Frac = Quot[Pair<Int, Int>, reduce] L2","example":"Frac<2, 4>","result":"Frac<1, 2>","evidence":"Designed canonicalization: reduce divides numerator and denominator by their gcd. Needs its own denominator-nonzero, idempotence and interface-equivalence checks; no certificate is attached here."},
      {"name":"Hour","definition":"obj Hour = Quot[Int, mod12] L2","example":"Hour<14>","result":"Hour<2>","evidence":"Designed canonicalization: mod12 chooses the hour representative. Needs its own modulo-12 idempotence and operation-interface checks; no certificate is attached here."}
