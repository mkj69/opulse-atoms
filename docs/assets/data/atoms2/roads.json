  "tower": [
    {"layer": 0, "kind": "object", "name": "Roads", "declaration": "obj Roads<nodes: List<Text>, edges: List<(Text,Text,Int)>> given", "depends_on": [], "description": "A finite undirected graph with positive integer weights."},
    {"layer": 0, "kind": "object", "name": "Edges", "declaration": "obj Edges<edge_ids: List<Text>> given", "depends_on": [], "description": "A sorted, duplicate-free set of public road IDs."},
    {"layer": 0, "kind": "object", "name": "Worst", "declaration": "obj Worst<cost: Int, closures: Edges, route: T> given", "depends_on": [], "description": "The worst cost, its closed roads and a surviving route."},
    {"layer": 0, "kind": "object", "name": "Metro", "declaration": "obj Metro: Roads given", "depends_on": [], "description": "Twelve junctions and 23 public, undirected, weighted roads."},
    {"layer": 0, "kind": "operation", "name": "edge", "declaration": "op edge(g, u, v) -> Outcome<Int> given", "depends_on": [], "description": "Read a road's weight or return Bottom(no_edge)."},
    {"layer": 0, "kind": "observation", "name": "?map", "declaration": "obs ?map{g} -> Roads given", "depends_on": [], "description": "Expose the current public graph."},
    {"layer": 0, "kind": "combinator", "name": "@chain", "declaration": "comb @chain[f, g](x) -> Outcome<C> given", "depends_on": [], "description": "Run one step after another, preserving the first failure."},
    {"layer": 0, "kind": "observation", "name": "?size", "declaration": "obs ?size{xs} -> Int given", "depends_on": [], "description": "Count an already visible finite list."},
    {"layer": 1, "kind": "object", "name": "Route", "declaration": "obj Route<g, vertices: List<Text>> L1", "depends_on": ["Roads", "edge"], "description": "Check each edge and reject repeated junctions."},
    {"layer": 2, "kind": "operation", "name": "cost", "declaration": "op cost(r: Route) -> Int L2", "depends_on": ["Route", "edge"], "description": "Add the weights along a valid route."},
    {"layer": 3, "kind": "combinator", "name": "@explore", "declaration": "comb @explore[edge](g, s, t) -> List<Route> L3", "depends_on": ["Route", "edge"], "description": "Enumerate simple routes by visiting unvisited neighbors."},
    {"layer": 4, "kind": "operation", "name": "best", "declaration": "op best(g, s, t) -> Outcome<Route> L4", "depends_on": ["@explore", "cost"], "description": "Choose least cost, then lexicographically first route."},
    {"layer": 5, "kind": "observation", "name": "?optimal", "declaration": "obs ?optimal{r: Route} -> Bool L5", "depends_on": ["Route", "cost", "best"], "description": "Compare a route's cost with the best route's cost."},
    {"layer": 6, "kind": "object", "name": "Closure", "declaration": "obj Closure<g, closed: Edges> L6", "depends_on": ["Roads", "Edges", "?map"], "description": "Represent a graph with a sorted set of closed roads."},
    {"layer": 7, "kind": "operation", "name": "close", "declaration": "op close(g, blocked: Edges) -> Closure L7", "depends_on": ["Closure", "?map"], "description": "Remove closed roads from the public map."},
    {"layer": 8, "kind": "combinator", "name": "@failures", "declaration": "comb @failures[close](g, b) -> List<Closure> L8", "depends_on": ["close", "?map"], "description": "Enumerate closures by size, then road IDs."},
    {"layer": 9, "kind": "observation", "name": "?survives", "declaration": "obs ?survives{g, s, t, b} -> Bool L9", "depends_on": ["@failures", "@explore"], "description": "Check reachability under every permitted closure."},
    {"layer": 10, "kind": "operation", "name": "worst", "declaration": "op worst(g, s, t, b) -> Outcome<Worst> L10", "depends_on": ["Worst", "@failures", "best", "cost"], "description": "Find the highest surviving shortest cost and first tied closure."},
    {"layer": 11, "kind": "operation", "name": "mincut", "declaration": "op mincut(g, s, t) -> Outcome<Edges> L11", "depends_on": ["Edges", "?map"], "description": "Find the smallest separating edge set across all vertex partitions."},
    {"layer": 12, "kind": "observation", "name": "?cut_certificate", "declaration": "obs ?cut_certificate{g, s, t} -> Bool L12", "depends_on": ["?survives", "mincut", "close", "@explore"], "description": "Check both the surviving lower bound and a disconnecting cut."}
